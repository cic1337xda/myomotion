# ==============================================================================
# MyoMotion - Neuromuscular & Upper-Limb Kinematics Rehabilitation Platform
# Example Environment Configuration (Copy to .env and fill in real values)
# ==============================================================================

# Application Ports (Verify free host ports using: ss -tulpn)
APP_PORT=8840
FRONTEND_PORT=8841
DB_PORT=5455
MQTT_PORT=1892
MQTT_WS_PORT=9002

# PostgreSQL Database
POSTGRES_USER=myomotion_admin
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=myomotion_rehab
DATABASE_URL=postgresql://myomotion_admin:replace_with_strong_database_password@myomotion_db:5432/myomotion_rehab

# JWT & Security
SECRET_KEY=replace_with_long_random_hex_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
ALLOWED_ORIGINS=localhost,127.0.0.1,your-domain.com

# Resend Email Service (OTP Verification)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=myomotion@mail.yourdomain.com

# MQTT Broker (Internal container hostname)
MQTT_BROKER_HOST=myomotion_mqtt
MQTT_BROKER_PORT=1883
